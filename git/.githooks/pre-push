#!/usr/bin/env bash

source ~/.githooks/shared.sh

branch=$(current_branch)
zero_sha="0000000000000000000000000000000000000000"
remote_name="${1:-origin}"

info "🚀 Pre-push triggered for: $branch"

gitleaks_scan_range() {
  local range="$1"
  local ref_name="$2"

  info "🔐 Running gitleaks on ${ref_name}"
  debug "gitleaks range: ${range}"

  gitleaks git --log-opts="$range" --redact . ||
    error "Potential secret leak detected in commits being pushed"
}

# Resolve the remote default branch (e.g. refs/remotes/origin/main).
remote_default_ref() {
  local remote="$1"
  local head_ref candidate

  head_ref=$(git symbolic-ref --quiet "refs/remotes/${remote}/HEAD" 2>/dev/null || true)
  if [ -n "$head_ref" ]; then
    printf '%s\n' "$head_ref"
    return 0
  fi

  for candidate in "refs/remotes/${remote}/main" "refs/remotes/${remote}/master"; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

# Commits unique to local_sha vs the remote default branch.
new_branch_scan_range() {
  local local_sha="$1"
  local remote="$2"
  local base_ref merge_base

  base_ref=$(remote_default_ref "$remote" || true)
  if [ -z "$base_ref" ]; then
    debug "No remote default for ${remote}; scanning tip commit only"
    printf '%s\n' "$local_sha^!"
    return 0
  fi

  merge_base=$(git merge-base "$local_sha" "$base_ref" 2>/dev/null || true)
  if [ -n "$merge_base" ]; then
    printf '%s\n' "${merge_base}..${local_sha}"
  else
    debug "No merge-base with ${base_ref}; scanning tip commit only"
    printf '%s\n' "$local_sha^!"
  fi
}

# Scan commits being pushed (pre-push stdin), not the staging area.
# Do NOT use `gitleaks protect --staged` — that scans the index only.
if has_command gitleaks; then
  scanned=0

  while read -r local_ref local_sha remote_ref remote_sha; do
    range=""

    if [ "$local_sha" = "$zero_sha" ]; then
      debug "Skipping delete of ${local_ref}"
      continue
    fi

    if [ "$remote_sha" = "$zero_sha" ]; then
      # New branch: only commits ahead of the remote default, not every remote ref.
      range=$(new_branch_scan_range "$local_sha" "$remote_name")
    else
      # Existing branch: only commits being pushed on this ref.
      range="${remote_sha}..${local_sha}"
    fi

    gitleaks_scan_range "$range" "$local_ref"
    scanned=$((scanned + 1))
  done

  if [ "$scanned" -eq 0 ]; then
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [ -n "$upstream" ]; then
      merge_base=$(git merge-base HEAD "$upstream" 2>/dev/null || true)
      if [ -n "$merge_base" ] && [ "$merge_base" != "$(git rev-parse HEAD)" ]; then
        gitleaks_scan_range "${merge_base}..HEAD" "${branch:-HEAD}"
      else
        debug "No unpushed commits vs ${upstream}; skipping gitleaks"
      fi
    else
      gitleaks_scan_range "HEAD^!" "${branch:-HEAD}"
    fi
  fi
else
  error "gitleaks is required for push checks. Please install gitleaks: https://github.com/gitleaks/gitleaks"
fi

# Large push detection — files changed in unpushed commits vs upstream.
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
if [ -n "$upstream" ]; then
  merge_base=$(git merge-base HEAD "$upstream" 2>/dev/null || true)
  if [ -n "$merge_base" ]; then
    changed_files=$(git diff --name-only "${merge_base}..HEAD" 2>/dev/null | wc -l | tr -d ' ')
  else
    changed_files=0
  fi
else
  changed_files=$(git diff --name-only HEAD~1..HEAD 2>/dev/null | wc -l | tr -d ' ')
fi

if [ "${changed_files:-0}" -gt 100 ]; then
  warn "Large push detected: ${changed_files} files"
fi

dispatch_hook pre-push

success "Pre-push checks passed"
