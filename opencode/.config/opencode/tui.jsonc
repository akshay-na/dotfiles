{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "one-dark",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,alt+return,ctrl+j"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 1.0
  }
}
