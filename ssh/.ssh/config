# =========================================
# SSH Config File - Enhanced Security & Performance
# =========================================

# -------------------------
# Default SSH Options (Global)
# -------------------------
Host *

    # ===== SECURITY SETTINGS =====

    # Verify host identity using known_hosts.
    # Never silently trust an unknown host key.
    StrictHostKeyChecking yes
    HashKnownHosts yes
    UserKnownHostsFile ~/.ssh/known_hosts

    # Automatically add successfully authenticated keys to ssh-agent.
    AddKeysToAgent yes

    # Modern, secure key exchange algorithms with compatible fallbacks.
    KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256

    # ===== AUTHENTICATION SETTINGS =====

    PreferredAuthentications publickey,password
    PubkeyAuthentication yes
    PasswordAuthentication yes
    KbdInteractiveAuthentication no
    GSSAPIAuthentication no

    # Enable explicitly only for trusted human workflows.
    ForwardAgent no

    # ===== CONNECTION OPTIMIZATION =====

    ForwardX11 no
    ForwardX11Trusted no

    # ===== PERFORMANCE SETTINGS =====

    Compression yes
    TCPKeepAlive yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # SSH multiplexing is disabled by default.
    # Enable explicitly only for trusted human-only hosts.
    ControlMaster no
    ControlPath none

    # ===== PORT FORWARDING SAFETY =====

    ExitOnForwardFailure yes
    StreamLocalBindUnlink yes

    # ===== LOGGING & DEBUGGING =====

    LogLevel INFO


 Include ~/.ssh/config_local

# -------------------------
# Git Hosts Configuration
# -------------------------

Host github.com
    HostName github.com
    User git

Host gitlab.com
    HostName gitlab.com
    User git

Host bitbucket.org
    HostName bitbucket.org
    User git

